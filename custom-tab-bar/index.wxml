<view class="tab-shell theme-{{theme}}">
  <view class="tab-island">
    <view
      wx:for="{{tabs}}"
      wx:key="path"
      wx:if="{{!item.requiresArticle || articleEnabled}}"
      class="tab-item {{selected === index ? 'tab-item--selected' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-item__symbol">{{item.symbol}}</text>
      <text class="tab-item__text">{{item.text}}</text>
    </view>
  </view>
</view>
