/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
page {
  --brand-blue: #2f80ed;
  --brand-cyan: #22a6f2;
  --brand-green: #22c55e;
  --text-primary: #172033;
  --text-secondary: #66758a;
  --text-tertiary: #8b98aa;
  --surface: rgba(255, 255, 255, 0.86);
  --surface-solid: #ffffff;
  --surface-muted: #f1f6fc;
  --surface-soft: rgba(255, 255, 255, 0.58);
  --chip-surface: rgba(232, 241, 255, 0.86);
  --control-surface: rgba(248, 250, 252, 0.72);
  --header-surface: rgba(255, 255, 255, 0.68);
  --tab-surface: rgba(255, 255, 255, 0.72);
  --divider: rgba(226, 232, 240, 0.76);
  --rich-text: #27364a;
  --warning-surface: rgba(255, 247, 220, 0.92);
  --warning-text: #745c25;
  --disabled-surface: #e5ebf2;
  --border: rgba(148, 163, 184, 0.16);
  --shadow-soft: 0 16rpx 44rpx rgba(31, 61, 103, 0.08);
  --shadow-brand: 0 18rpx 42rpx rgba(47, 128, 237, 0.22);
  min-height: 100%;
  color: var(--text-primary);
  background:
    radial-gradient(circle at 104% 8%, rgba(89, 146, 255, 0.2), transparent 34%),
    radial-gradient(circle at -8% 44%, rgba(34, 197, 94, 0.12), transparent 28%),
    linear-gradient(160deg, #eef6ff 0%, #f9fbff 48%, #edf5ff 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.theme-light,
.theme-dark {
  color: var(--text-primary);
  transition: color 180ms ease, background 180ms ease;
}

.theme-light {
  background-color: #eef6ff;
  background:
    radial-gradient(circle at 104% 8%, rgba(89, 146, 255, 0.2), transparent 34%),
    radial-gradient(circle at -8% 44%, rgba(34, 197, 94, 0.12), transparent 28%),
    linear-gradient(160deg, #eef6ff 0%, #f9fbff 48%, #edf5ff 100%);
}

.theme-dark {
  --text-primary: #e9f0fb;
  --text-secondary: #a9b7ca;
  --text-tertiary: #7f91a8;
  --surface: rgba(20, 31, 49, 0.88);
  --surface-solid: #152033;
  --surface-muted: #1a2940;
  --surface-soft: rgba(25, 39, 61, 0.72);
  --chip-surface: rgba(35, 52, 78, 0.9);
  --control-surface: rgba(30, 45, 68, 0.9);
  --header-surface: rgba(16, 27, 44, 0.82);
  --tab-surface: rgba(16, 27, 44, 0.9);
  --divider: rgba(111, 130, 157, 0.2);
  --rich-text: #d7e1ef;
  --warning-surface: rgba(92, 67, 24, 0.55);
  --warning-text: #f0cc7a;
  --disabled-surface: #26354a;
  --border: rgba(148, 163, 184, 0.18);
  --shadow-soft: 0 16rpx 44rpx rgba(0, 0, 0, 0.24);
  --shadow-brand: 0 18rpx 42rpx rgba(12, 57, 126, 0.38);
  background-color: #0b1220;
  background:
    radial-gradient(circle at 104% 8%, rgba(47, 128, 237, 0.18), transparent 34%),
    radial-gradient(circle at -8% 44%, rgba(34, 197, 94, 0.08), transparent 28%),
    linear-gradient(160deg, #0b1220 0%, #101a2b 52%, #0c1626 100%);
}

button {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page-scroll {
  width: 100%;
  height: 100vh;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom));
}

.page-shell--plain {
  padding-bottom: 48rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 20rpx;
}

.section-heading__title {
  font-size: 30rpx;
  font-weight: 800;
}

.section-heading__action {
  color: var(--text-tertiary);
  font-size: 23rpx;
}

.pressable {
  transition: transform 120ms ease, opacity 120ms ease;
}

.pressable:active {
  opacity: 0.88;
  transform: scale(0.975);
}

.fade-up {
  animation: fade-up 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .theme-light,
  .theme-dark,
  .pressable,
  .fade-up {
    animation: none;
    transition: none;
  }
}
