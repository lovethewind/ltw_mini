.dialog-backdrop { position:fixed; top:0; right:0; bottom:0; left:0; z-index:300; display:flex; align-items:flex-end; justify-content:center; background:rgba(7,15,28,.42); animation:dialog-fade-in 180ms ease-out; }
.dialog-backdrop--center { padding:28rpx; box-sizing:border-box; align-items:center; justify-content:center; }
.dialog-panel { width:100%; max-height:78vh; box-sizing:border-box; padding:10rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:34rpx 34rpx 0 0; background:var(--surface-solid,#fff); box-shadow:0 -24rpx 64rpx rgba(7,24,49,.2); animation:dialog-slide-in 260ms cubic-bezier(.16,1,.3,1); }
.dialog-panel--center { width:100%; max-width:640rpx; padding:36rpx; border:1rpx solid rgba(255,255,255,.72); border-radius:30rpx; box-shadow:0 28rpx 80rpx rgba(7,24,49,.26); animation:dialog-center-in 220ms cubic-bezier(.16,1,.3,1); }
.dialog-handle { width:68rpx; height:7rpx; margin:0 auto 20rpx; border-radius:999rpx; background:var(--border,#d9e3ef); }
.dialog-heading { padding:0 4rpx 22rpx; }.dialog-title,.dialog-description { display:block; }.dialog-title { color:var(--text-primary,#142033); font-size:35rpx; font-weight:850; line-height:1.35; }.dialog-description { margin-top:8rpx; color:var(--text-secondary,#6f8199); font-size:23rpx; line-height:1.6; }
.dialog-input { width:100%; height:82rpx; box-sizing:border-box; padding:0 22rpx; border:1rpx solid var(--border,#d9e3ef); border-radius:20rpx; color:var(--text-primary,#142033); background:var(--control-surface,#f4f7fb); font-size:25rpx; }
.dialog-options { max-height:52vh; }.dialog-options--select { height:52vh; }.dialog-option { min-height:96rpx; margin-bottom:10rpx; padding:16rpx 22rpx; box-sizing:border-box; display:flex; align-items:center; gap:18rpx; border:1rpx solid var(--border,#d9e3ef); border-radius:20rpx; color:var(--text-primary,#142033); background:var(--control-surface,#f4f7fb); }.dialog-option:active { border-color:rgba(47,128,237,.28); background:rgba(47,128,237,.08); transform:scale(.985); }.dialog-option--selected { border-color:rgba(47,128,237,.22); color:#2f80ed; background:rgba(47,128,237,.1); }.dialog-option--danger { color:#e5484d; background:rgba(229,72,77,.06); }.dialog-option__icon { width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; flex:none; border-radius:13rpx; color:#2f80ed; background:rgba(47,128,237,.1); font-size:21rpx; font-weight:800; }.dialog-option__main { min-width:0; flex:1; }.dialog-option__label,.dialog-option__description { display:block; }.dialog-option__label { font-size:28rpx; font-weight:760; line-height:1.5; }.dialog-option__description { margin-top:4rpx; color:var(--text-secondary,#6f8199); font-size:21rpx; line-height:1.45; }.dialog-option__check { color:#2f80ed; font-size:28rpx; font-weight:800; }.dialog-option__arrow { color:var(--text-tertiary,#91a0b5); font-size:32rpx; }
.dialog-content { display:block; max-height:38vh; overflow:auto; padding:4rpx 4rpx 20rpx; color:var(--text-secondary,#6f8199); font-size:24rpx; line-height:1.7; white-space:pre-wrap; }
.dialog-actions { margin-top:26rpx; display:flex; gap:12rpx; }.dialog-button,.dialog-cancel { height:78rpx; margin:0; display:flex; align-items:center; justify-content:center; padding:0; border:0; border-radius:20rpx; font-size:26rpx; font-weight:780; line-height:1; }.dialog-button::after,.dialog-cancel::after { border:0; }.dialog-button { min-width:0; flex:1; }.dialog-button--cancel,.dialog-cancel { color:var(--text-secondary,#6f8199); background:var(--control-surface,#f4f7fb); }.dialog-button--primary { color:#fff; background:#2f80ed; }.dialog-button--danger { color:#fff; background:#e5484d; }.dialog-cancel { width:100%; margin-top:8rpx; }
@keyframes dialog-fade-in { from { opacity:0; } to { opacity:1; } } @keyframes dialog-slide-in { from { opacity:0; transform:translateY(36rpx); } to { opacity:1; transform:translateY(0); } } @keyframes dialog-center-in { from { opacity:0; transform:scale(.96); } to { opacity:1; transform:scale(1); } }
@media (prefers-reduced-motion: reduce) { .dialog-backdrop,.dialog-panel { animation:none; } }
