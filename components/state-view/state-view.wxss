.state-view {
  box-sizing: border-box;
  width: 100%;
  padding: 80rpx 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.state-view__icon {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2f80ed, #22a6f2);
  box-shadow: 0 20rpx 42rpx rgba(47, 128, 237, 0.22);
  font-size: 52rpx;
  font-weight: 700;
}

.state-view--loading .state-view__icon text {
  animation: spin 900ms linear infinite;
}

.state-view--success .state-view__icon {
  background: linear-gradient(135deg, #20a969, #30c998);
  box-shadow: 0 20rpx 42rpx rgba(32, 169, 105, 0.2);
}

.state-view--error .state-view__icon {
  background: linear-gradient(135deg, #ef6b6b, #f59a73);
  box-shadow: 0 20rpx 42rpx rgba(239, 107, 107, 0.18);
}

.state-view__title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.state-view__description {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.state-view__button {
  min-width: 220rpx;
  height: 82rpx;
  margin-top: 30rpx;
  padding: 0 34rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2f80ed, #22a6f2);
  box-shadow: 0 16rpx 34rpx rgba(47, 128, 237, 0.2);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 82rpx;
  transition: transform 120ms ease, opacity 120ms ease;
}

.state-view__button:active {
  opacity: 0.88;
  transform: scale(0.97);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
