<view class="state-view state-view--{{type}} fade-up">
  <view class="state-view__icon">
    <image wx:if="{{loading || type === 'loading'}}" class="state-view__spinner" src="/images/loading-spinner.svg" mode="aspectFit" aria-label="加载中"></image>
    <text wx:elif="{{type === 'success'}}">✓</text>
    <text wx:elif="{{type === 'error'}}">!</text>
    <text wx:else>⌁</text>
  </view>
  <text class="state-view__title">{{title}}</text>
  <text wx:if="{{description}}" class="state-view__description">{{description}}</text>
  <button wx:if="{{actionText}}" class="state-view__button" bindtap="handleAction">{{actionText}}</button>
</view>
