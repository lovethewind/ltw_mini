.hero {
  position: relative;
  box-sizing: border-box;
  min-height: 300rpx;
  padding: 44rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 42rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #246bfd, #5b92ff 58%, #8cb3ff);
  box-shadow: var(--shadow-brand);
}

.hero__orb {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero__orb--top {
  width: 260rpx;
  height: 260rpx;
  top: -120rpx;
  right: -70rpx;
}

.hero__orb--bottom {
  width: 150rpx;
  height: 150rpx;
  right: 150rpx;
  bottom: -110rpx;
}

.hero__eyebrow {
  position: relative;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  opacity: 0.75;
}

.hero__title {
  position: relative;
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  font-size: 50rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero__description {
  position: relative;
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.quick-grid {
  margin-top: 24rpx;
  display: flex;
  animation-delay: 60ms;
}

.quick-card {
  width: 0;
  min-width: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--border);
  border-radius: 30rpx;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.quick-card + .quick-card {
  margin-left: 20rpx;
}

.quick-card__icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #2f80ed;
  background: rgba(47, 128, 237, 0.1);
  font-size: 38rpx;
  font-weight: 700;
}

.quick-card__icon-image {
  width: 40rpx;
  height: 40rpx;
}

.quick-card__title {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.quick-card__description {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
  line-height: 1.5;
}
