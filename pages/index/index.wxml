<page-meta page-style="background-color: {{theme === 'dark' ? '#0b1220' : '#eef6ff'}};"></page-meta>
<scroll-view class="page-scroll theme-{{theme}}" scroll-y enhanced show-scrollbar="{{false}}">
  <liquid-header title="心悦心享" show-logo="{{true}}" show-theme="{{true}}"></liquid-header>

  <view class="page-shell">
  <view class="hero fade-up">
    <view class="hero__orb hero__orb--top"></view>
    <view class="hero__orb hero__orb--bottom"></view>
    <text class="hero__eyebrow">TODAY · 心情随笔</text>
    <view class="hero__title">
      <text>让每一次记录</text>
      <text>都有温度</text>
    </view>
    <text class="hero__description">分享技术、生活与沿途的微小欢喜</text>
  </view>

  <view class="quick-grid fade-up">
    <view class="quick-card pressable" bindtap="scanCode">
      <view class="quick-card__icon">
        <image class="quick-card__icon-image" src="/images/scan.svg" mode="aspectFit"></image>
      </view>
      <text class="quick-card__title">扫码验证</text>
      <text class="quick-card__description">确认网站登录与账号操作</text>
    </view>
    <view class="quick-card pressable" bindtap="openArticles">
      <view class="quick-card__icon">⌕</view>
      <text class="quick-card__title">浏览文章</text>
      <text class="quick-card__description">看看最近写下的新内容</text>
    </view>
  </view>

  <view class="section-heading">
    <text class="section-heading__title">最近更新</text>
    <text class="section-heading__action" bindtap="openArticles">查看全部 →</text>
  </view>

  <state-view
    wx:if="{{loading}}"
    type="loading"
    title="正在加载文章"
    description="稍等一下，新内容马上就来"
  ></state-view>
  <state-view
    wx:elif="{{error}}"
    type="error"
    title="内容加载失败"
    description="{{error}}"
    action-text="重新加载"
    bind:action="loadArticles"
  ></state-view>
  <state-view
    wx:elif="{{!articles.length}}"
    title="暂时没有文章"
    description="等风带来第一篇新内容"
  ></state-view>
  <view wx:else class="article-list fade-up">
    <article-card
      wx:for="{{articles}}"
      wx:key="id"
      article="{{item}}"
      bind:select="openArticle"
    ></article-card>
  </view>
  </view>
</scroll-view>
