.article-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.article-filter {
  flex: none;
  box-sizing: border-box;
  padding: 20rpx 20rpx 0;
}

.article-content {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
}

.article-content__shell {
  min-height: 100%;
  padding: 0 20rpx calc(156rpx + env(safe-area-inset-bottom));
}

.search-bar {
  height: 80rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.search-bar__icon {
  color: var(--text-secondary);
  font-size: 34rpx;
}

.search-bar__input {
  min-width: 0;
  flex: 1;
  color: var(--text-primary);
  font-size: 26rpx;
}

.search-bar__action {
  color: #2f80ed;
  font-size: 24rpx;
  font-weight: 700;
}

.category-scroll {
  width: 100%;
  height: 60rpx;
  margin: 18rpx 0 16rpx;
  white-space: nowrap;
}

.category-list {
  height: 100%;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  gap: 10rpx;
  padding: 2rpx;
}

.category-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: var(--text-secondary);
  background: var(--chip-surface);
  font-size: 22rpx;
  transition: color 180ms ease, background 180ms ease, transform 120ms ease;
}

.category-chip:active {
  transform: scale(0.96);
}

.category-chip--selected {
  color: #ffffff;
  background: linear-gradient(135deg, #2f80ed, #22a6f2);
  box-shadow: 0 10rpx 24rpx rgba(47, 128, 237, 0.2);
}

.list-footer {
  padding: 24rpx 0 12rpx;
  color: var(--text-tertiary);
  text-align: center;
  font-size: 23rpx;
}
