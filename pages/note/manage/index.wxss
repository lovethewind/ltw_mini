.resource-page { width:100%; height:100vh; display:flex; flex-direction:column; overflow:hidden; background:var(--page-bg); }.resource-shell { min-height:0; padding:24rpx 24rpx 0; flex:1; display:flex; flex-direction:column; }.resource-toolbar { position:relative; width:100%; box-sizing:border-box; flex:none; align-self:stretch; }.resource-list-scroll { min-height:0; flex:1; }
.resource-heading,.resource-heading__main { width:100%; box-sizing:border-box; }.resource-tabs,.resource-card,.resource-heading__main { display:flex; align-items:center; }.resource-heading__main { position:relative; height:62rpx; margin-top:8rpx; padding-right:158rpx; }.resource-heading__eyebrow { display:block; color:#2f80ed; font-size:20rpx; font-weight:800; letter-spacing:2rpx; }.resource-heading__title { display:block; color:var(--text-primary); font-size:40rpx; font-weight:850; line-height:62rpx; }
.resource-create { position:absolute; top:0; right:0; z-index:1; width:138rpx !important; height:62rpx; margin:0; padding:0; border:0; border-radius:18rpx; color:#fff; background:#2f80ed; font-size:23rpx; font-weight:750; line-height:62rpx; white-space:nowrap; }
.resource-tabs { margin:26rpx 0 18rpx; padding:7rpx; border-radius:20rpx; background:var(--surface); }.resource-tab { flex:1; padding:16rpx; border-radius:15rpx; color:var(--text-secondary); font-size:24rpx; font-weight:700; text-align:center; }.resource-tab--active { color:#2f80ed; background:rgba(47,128,237,.11); }
.resource-list { padding:0 0 calc(56rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:14rpx; }.resource-card { padding:22rpx 16rpx 22rpx 22rpx; border:1rpx solid var(--border); border-radius:22rpx; background:var(--surface); }.resource-card__icon { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:17rpx; color:#2f80ed; background:rgba(47,128,237,.1); font-size:27rpx; font-weight:800; }.resource-card__name { min-width:0; margin-left:18rpx; flex:1; overflow:hidden; color:var(--text-primary); font-size:27rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }.resource-card__more { width:64rpx !important; height:52rpx; margin:0 0 0 auto; padding:0; display:flex; align-items:center; justify-content:center; flex:none !important; align-self:center; border:0; background:transparent; line-height:1; }.resource-card__more::after { border:0; }.resource-card__more-dots { display:flex; align-items:center; justify-content:center; gap:6rpx; }.resource-card__more-dot { width:7rpx; height:7rpx; border-radius:50%; background:var(--text-secondary); }.resource-empty { padding:80rpx 0; color:var(--text-secondary); font-size:24rpx; text-align:center; }
