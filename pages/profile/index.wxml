<page-meta page-style="background-color: {{theme === 'dark' ? '#0b1220' : '#eef6ff'}};"></page-meta>
<scroll-view class="page-scroll theme-{{theme}}" scroll-y enhanced show-scrollbar="{{false}}">
  <liquid-header title="我"></liquid-header>

  <view class="page-shell">
  <state-view
    wx:if="{{loading}}"
    type="loading"
    loading="{{true}}"
    title="正在加载账号信息"
    description="按当前登录方式查询站内资料"
  ></state-view>
  <view wx:elif="{{unbound}}" class="bind-guide fade-up">
    <view class="bind-guide__icon">
      <image src="/images/brand-icon.png" mode="aspectFill"></image>
    </view>
    <text class="bind-guide__title">当前微信尚未绑定</text>
    <text class="bind-guide__description">完成关联后，即可在小程序查看 UID、头像和站内账号信息。</text>

    <view class="bind-guide__routes">
      <view class="bind-route">
        <view class="bind-route__heading">
          <text class="bind-route__badge">已有账号</text>
          <text class="bind-route__title">前往网站个人中心</text>
        </view>
        <text class="bind-route__path">账号绑定 → 微信 → 扫码完成绑定</text>
      </view>
      <view class="bind-route bind-route--login pressable" bindtap="openLogin">
        <view class="bind-route__heading">
          <text class="bind-route__badge bind-route__badge--login">已有账号</text>
          <text class="bind-route__title">小程序登录</text>
        </view>
        <text class="bind-route__path bind-route__path--login">点击填写用户名和密码，登录后查看笔记</text>
      </view>
      <view class="bind-route bind-route--new pressable" bindtap="openRegister">
        <view class="bind-route__heading">
          <text class="bind-route__badge bind-route__badge--new">新用户</text>
          <text class="bind-route__title">微信注册</text>
        </view>
        <text class="bind-route__path bind-route__path--new">点击填写用户名和密码，完成注册</text>
      </view>
    </view>

    <view wx:if="{{registerVisible}}" class="register-panel fade-up">
      <view class="register-panel__heading">
        <view>
          <text class="register-panel__title">注册新账号</text>
          <text class="register-panel__description">注册后当前微信会自动完成绑定</text>
        </view>
        <text class="register-panel__close" bindtap="closeRegister">关闭</text>
      </view>
      <view class="register-panel__field">
        <input class="register-panel__input" value="{{registerForm.username}}" maxlength="20" placeholder="用户名（3-20个字符）" data-field="username" bindinput="updateRegisterField" bindblur="checkRegisterUsername" />
        <text wx:if="{{registerUsernameChecking}}" class="register-panel__hint">正在检查用户名…</text>
        <text wx:elif="{{registerUsernameExists}}" class="register-panel__hint register-panel__hint--error">该用户名已存在，请更换</text>
      </view>
      <input class="register-panel__input" value="{{registerForm.password}}" maxlength="30" password placeholder="密码（6-30个字符）" data-field="password" bindinput="updateRegisterField" />
      <input class="register-panel__input" value="{{registerForm.nickname}}" maxlength="20" placeholder="昵称（选填，默认使用用户名）" data-field="nickname" bindinput="updateRegisterField" />
      <view class="register-panel__actions">
        <button class="register-panel__button register-panel__button--cancel" disabled="{{registerSubmitting}}" bindtap="closeRegister">取消</button>
        <button class="register-panel__button register-panel__button--submit" loading="{{registerSubmitting}}" bindtap="submitRegister">{{registerSubmitting ? '注册中…' : '注册并进入笔记'}}</button>
      </view>
    </view>

    <button class="bind-guide__button pressable" bindtap="loadProfile">我已完成绑定</button>
    <text class="bind-guide__tip">完成后返回这里，点击按钮即可刷新账号状态</text>
  </view>
  <state-view
    wx:elif="{{error}}"
    type="error"
    title="账号信息加载失败"
    description="{{error}}"
    action-text="重新加载"
    bind:action="loadProfile"
  ></state-view>

  <view wx:elif="{{user}}" class="profile fade-up">
    <view class="profile-hero">
      <view class="profile-hero__glow"></view>
      <view class="profile-hero__top">
        <image wx:if="{{user.avatar}}" class="profile-hero__avatar" src="{{user.avatar}}" mode="aspectFill"></image>
        <view wx:else class="profile-hero__avatar profile-hero__avatar--empty">悦</view>
        <view class="profile-hero__identity">
          <text class="profile-hero__name">{{user.nickname}}</text>
          <view class="profile-hero__meta">
            <view class="profile-hero__uid-tag">
              <text class="profile-hero__uid-label">UID</text>
              <text class="profile-hero__uid-value">{{user.uid || '暂无'}}</text>
            </view>
            <text wx:if="{{user.gender === 1}}" class="profile-hero__gender profile-hero__gender--male" aria-label="男">♂</text>
            <text wx:elif="{{user.gender === 2}}" class="profile-hero__gender profile-hero__gender--female" aria-label="女">♀</text>
            <text wx:else class="profile-hero__gender profile-hero__gender--secret" aria-label="性别保密">○</text>
            <text class="profile-hero__username">{{loggedIn ? (wechatBound ? '账号已登录 · 微信已关联' : '账号已登录') : '已关联微信'}}</text>
          </view>
        </view>
      </view>
      <text class="profile-hero__summary">{{user.summary || '这个人很神秘，还没有留下个人简介。'}}</text>
    </view>

    <view class="section-heading">
      <text class="section-heading__title">账号信息</text>
    </view>
    <view class="info-card">
      <view class="info-row">
        <text class="info-row__label">用户编号</text>
        <text class="info-row__value">{{user.id}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">登录状态</text>
        <text class="info-row__value {{loggedIn ? 'info-row__value--success' : ''}}">{{loggedIn ? '已登录' : '未登录'}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">UID</text>
        <text class="info-row__value">{{user.uid || '暂未分配'}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">性别</text>
        <text class="info-row__value">{{user.gender === 1 ? '男' : user.gender === 2 ? '女' : '保密'}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">微信状态</text>
        <text class="info-row__value {{wechatBound ? 'info-row__value--success' : ''}}">{{wechatBound ? '已关联' : '未关联'}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">所在地区</text>
        <text class="info-row__value">{{user.address || '暂未填写'}}</text>
      </view>
    </view>

      <view class="profile-actions">
      <button wx:if="{{loggedIn}}" class="profile-actions__button profile-actions__button--danger pressable" bindtap="logout">退出登录</button>
      <view wx:else class="profile-actions__group">
        <button class="profile-actions__button pressable" bindtap="openLogin">账号登录</button>
        <button wx:if="{{wechatBound}}" class="profile-actions__button profile-actions__button--wechat pressable" loading="{{wechatLoginSubmitting}}" bindtap="wechatLogin">{{wechatLoginSubmitting ? '微信登录中…' : '微信登录'}}</button>
      </view>
    </view>

  </view>

  <view wx:if="{{loginVisible}}" class="register-panel login-panel fade-up">
    <view class="register-panel__heading">
      <view>
        <text class="register-panel__title">账号登录</text>
        <text class="register-panel__description">登录后可使用当前账号的私人笔记</text>
      </view>
      <text class="register-panel__close" bindtap="closeLogin">关闭</text>
    </view>
    <input class="register-panel__input" value="{{loginForm.username}}" maxlength="20" placeholder="用户名（3-20个字符）" data-field="username" bindinput="updateLoginField" />
    <input class="register-panel__input" value="{{loginForm.password}}" password placeholder="密码" data-field="password" bindinput="updateLoginField" />
    <view class="register-panel__actions">
      <button class="register-panel__button register-panel__button--cancel" disabled="{{loginSubmitting}}" bindtap="closeLogin">取消</button>
      <button class="register-panel__button register-panel__button--submit" loading="{{loginSubmitting}}" bindtap="submitLogin">{{loginSubmitting ? '登录中…' : '登录'}}</button>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" class="website-card fade-up">
    <image class="website-card__icon" src="/images/brand-icon.png" mode="aspectFill"></image>
    <view class="website-card__content">
      <text class="website-card__label">官方网站</text>
      <text class="website-card__address" user-select="{{true}}">lovethewind.cn</text>
      <text class="website-card__description">登录、绑定账号及管理内容请访问网站</text>
    </view>
    <text class="website-card__tip">长按复制</text>
  </view>
  </view>
</scroll-view>
