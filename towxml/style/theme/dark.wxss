/*正文样式*/
.h2w-dark {
  color: var(--h2w-text);
  background-color: transparent;
}

/**标题**/
.h2w-dark .h2w__h1,
.h2w-dark .h2w__h2 {
    border-color: var(--h2w-border);
}


/**表格**/
.h2w-dark .h2w__thead .h2w__tr {
    background-color: var(--h2w-thead-bg);
}
.h2w-dark .h2w__table .h2w__tr:nth-child(2n){
    background-color: var(--h2w-stripe-bg);
}
.h2w-dark .h2w__th,
.h2w-dark .h2w__td {
    border-color: var(--h2w-cell-border);
}


/**代码块**/
.h2w-dark .h2w__pre,
.h2w-dark .h2w__pre .h2w__code {
    background-color: var(--h2w-pre-bg);
    border-color: var(--h2w-pre-border);
}

.h2w-dark .h2w__code {
    background-color: var(--h2w-code-bg);
    border-color: var(--h2w-code-border);
}


/**块元素**/
.h2w-dark .h2w__blockquote {
    border-left-color: var(--h2w-blockquote-border);
    background-color: var(--h2w-blockquote-bg);
}

/**内连元素**/
.h2w-dark .h2w__a {
    color: var(--h2w-link-color); border-color: var(--h2w-link-border);
}

.h2w-dark .h2w__hr {
    background-color: var(--h2w-hr-bg);
}

.h2w-dark .h2w__mark {
    background: var(--h2w-mark-bg);
    color: var(--h2w-mark-color);
}

.h2w-dark .h2w__todoCheckbox .wx-checkbox-input {
    background: var(--h2w-todo-checkbox-bg); border-color: var(--h2w-todo-checkbox-border);
}
.h2w-dark .h2w__todoCheckbox .wx-checkbox-input.wx-checkbox-input-checked {
    background: var(--h2w-todo-checkbox-checked-bg); border-color: var(--h2w-todo-checkbox-checked-border);
}
.h2w-dark .h2w__todoCheckbox .wx-checkbox-input.wx-checkbox-input-checked::before {
    color: white;
}
.h2w-dark .h2w__lineNum {
    color: var(--h2w-linenum-color);
}

/**代码高亮样式**/
@import '../../parse/highlight/style/monokai.wxss';
