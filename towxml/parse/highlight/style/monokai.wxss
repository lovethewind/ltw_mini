/*
Monokai style - ported by Luigi Maselli - http://grigio.org
*/

.h2w-dark .hljs {
  display: block;
  overflow-x: auto;
  padding: 0.5em;
  background: var(--h2w-code-highlight);
  color: var(--h2w-code-highlight-text);
}

.h2w-dark .hljs-tag,
.h2w-dark .hljs-keyword,
.h2w-dark .hljs-selector-tag,
.h2w-dark .hljs-literal,
.h2w-dark .hljs-strong,
.h2w-dark .hljs-name {
  color: var(--h2w-code-highlight-keyword-color);
}

.h2w-dark .hljs-code {
  color: var(--h2w-code-highlight-number-color);
}

.h2w-dark .hljs-class .hljs-title {
  color: var(--h2w-code-highlight-title-color);
}

.h2w-dark .hljs-attribute,
.h2w-dark .hljs-symbol,
.h2w-dark .hljs-regexp,
.h2w-dark .hljs-link {
  color: var(--h2w-code-highlight-regexp-color);
}

.h2w-dark .hljs-string,
.h2w-dark .hljs-bullet,
.h2w-dark .hljs-subst,
.h2w-dark .hljs-title,
.h2w-dark .hljs-section,
.h2w-dark .hljs-emphasis,
.h2w-dark .hljs-type,
.h2w-dark .hljs-built_in,
.h2w-dark .hljs-builtin-name,
.h2w-dark .hljs-selector-attr,
.h2w-dark .hljs-selector-pseudo,
.h2w-dark .hljs-addition,
.h2w-dark .hljs-variable,
.h2w-dark .hljs-template-tag,
.h2w-dark .hljs-template-variable {
  color: var(--h2w-code-highlight-string-color);
}

.h2w-dark .hljs-comment,
.h2w-dark .hljs-quote,
.h2w-dark .hljs-deletion,
.h2w-dark .hljs-meta {
  color: var(--h2w-code-highlight-comment-color);
}

.h2w-dark .hljs-keyword,
.h2w-dark .hljs-selector-tag,
.h2w-dark .hljs-literal,
.h2w-dark .hljs-doctag,
.h2w-dark .hljs-title,
.h2w-dark .hljs-section,
.h2w-dark .hljs-type,
.h2w-dark .hljs-selector-id {
  font-weight: bold;
}
